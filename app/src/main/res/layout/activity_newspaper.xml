<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="16dp">

    <!-- 상단 헤더-->
    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/news_viewer"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>


    <!-- 섹션 탭 목록 (가로 나열) -->
    <HorizontalScrollView
        android:id="@+id/tabScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle">

        <LinearLayout
            android:id="@+id/tabLayoutContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <View
        android:id="@+id/dividerTabs"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/black"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tabScrollView"/>

    <!-- 본문 콘텐츠 영역 -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/dividerTabs"
        app:layout_constraintBottom_toTopOf="@id/navBar">

        <!-- 1. INDEX 모드: RecyclerView로 교체 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvIndex"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="vertical"
            android:visibility="visible" />

        <!-- 2. 기사 본문 모드 컨테이너 -->
        <LinearLayout
            android:id="@+id/layoutIndex"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/layoutArticle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 기사 상세 제목 -->
            <TextView
                android:id="@+id/tvArticleTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="24sp"
                android:lineSpacingMultiplier="1.2"/>

            <!-- 기사제목과 본문 사이의 컨트롤 바 (폰트 크기 및 줄간격 조절) -->
            <LinearLayout
                android:id="@+id/layoutFontSizeControl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical|end"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp">

                <!-- [2] 줄간격 조절 (새로 추가) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="줄간격"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnLineSpacingMinus"
                    android:layout_width="38dp"
                    android:layout_height="32dp"
                    android:text="-"
                    android:textColor="@color/black"
                    android:background="@drawable/border_button"
                    app:backgroundTint="@null"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:padding="0dp"/>

                <Button
                    android:id="@+id/btnLineSpacingPlus"
                    android:layout_width="38dp"
                    android:layout_height="32dp"
                    android:text="+"
                    android:textColor="@color/black"
                    android:background="@drawable/border_button"
                    app:backgroundTint="@null"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:padding="0dp"
                    android:layout_marginStart="4dp"/>

                <!-- 구분선 -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:background="#CCCCCC"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"/>

                <!-- 글자 크기 조절 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_resize"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnFontMinus"
                    android:layout_width="38dp"
                    android:layout_height="32dp"
                    android:text="-"
                    android:textColor="@color/black"
                    android:background="@drawable/border_button"
                    app:backgroundTint="@null"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:padding="0dp"/>

                <Button
                    android:id="@+id/btnFontPlus"
                    android:layout_width="38dp"
                    android:layout_height="32dp"
                    android:text="+"
                    android:textColor="@color/black"
                    android:background="@drawable/border_button"
                    app:backgroundTint="@null"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:padding="0dp"
                    android:layout_marginStart="4dp"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black"
                android:layout_marginBottom="8dp"/>

            <!-- 스크롤바 없는 정적 스크롤뷰 (물리 버튼으로만 반 페이지씩 이동) -->
            <ScrollView
                android:id="@+id/articleScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tvArticleBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="22sp"
                    android:lineSpacingMultiplier="1.35"/>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- 하단 페이지 넘김 & 반 페이지 스크롤 조작 바 -->
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnHome"
            android:layout_width="70dp"
            android:layout_height="48dp"
            android:text="@string/home"
            android:textColor="@color/black"
            android:background="@drawable/border_button"
            app:backgroundTint="@null"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <Button
            android:id="@+id/btnPrev"
            android:layout_width="65dp"
            android:layout_height="48dp"
            android:text="@string/article_back"
            android:textColor="@color/black"
            android:background="@drawable/border_button"
            app:backgroundTint="@null"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            android:padding="0dp"/>

        <!-- 반 페이지 위로 스크롤 (△) -->
        <Button
            android:id="@+id/btnScrollUp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="@string/scroll_up"
            android:textColor="@color/black"
            android:background="@drawable/border_button"
            app:backgroundTint="@null"
            android:textSize="12sp"
            android:layout_marginStart="10dp"
            android:padding="0dp"/>




        <TextView
            android:id="@+id/tvPageIndicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tv_page_indicator"
            android:textColor="@color/black"
            android:layout_margin="1dp"
            android:textSize="10sp"
            android:textStyle="bold"/>


        <!-- 반 페이지 아래로 스크롤 (▽) -->
        <Button
            android:id="@+id/btnScrollDown"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="@string/scroll_down"
            android:textColor="@color/black"
            android:background="@drawable/border_button"
            app:backgroundTint="@null"
            android:textSize="12sp"
            android:layout_marginStart="10dp"
            android:padding="0dp"/>

        <Button
            android:id="@+id/btnNext"
            android:layout_width="65dp"
            android:layout_height="48dp"
            android:text="@string/article_next"
            android:textColor="@color/black"
            android:background="@drawable/border_button"
            app:backgroundTint="@null"
            android:textSize="10sp"
            android:layout_marginStart="10dp"
            android:padding="0dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>